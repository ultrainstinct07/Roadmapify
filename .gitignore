# Local exports at the repository root. Keep packaged HTML, review templates,
# Graphify fixtures and documentation artwork trackable.
/roadmap.html
/goal.html

# Interrupted roadmapify atomic writes (the destination may be outside roadmap-out).
.rmap-*.tmp

# The marked block also ignores goal.html, .roadmap.lock and .goal-run.json.
# Goal-run state is local but needed for recovery: ignored does not mean safe
# to delete while an agent host owns a step.

# >>> roadmapify >>>
# Derived and disposable. The two append-only logs below are the durable
# memory and ARE tracked — they carry decisions and observed git facts.
roadmap-out/*
!roadmap-out/journal.jsonl
!roadmap-out/evidence.jsonl
# <<< roadmapify <<<
